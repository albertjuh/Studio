
{
  "entities": {
    "AncRegistration": {
      "title": "ANC Registration",
      "description": "Represents a participant's registration in the ANC cohort study.",
      "type": "object",
      "properties": {
        "participantId": {
          "type": "string",
          "description": "Unique ID for the participant, prefixed by health facility ID."
        },
        "healthFacility": {
          "type": "string",
          "description": "The health facility where registration occurred."
        },
        "name": {
          "type": "string",
          "description": "Full name of the participant."
        },
        "age": {
          "type": "number",
          "description": "Age of the participant in years."
        },
        "maritalStatus": {
          "type": "string",
          "enum": [
            "Single",
            "Married",
            "Divorced",
            "Widowed"
          ]
        },
        "phoneNumber": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of the participant's phone numbers."
        },
        "nextOfKinName": {
          "type": "string",
          "description": "Name of the next of kin."
        },
        "alternativeContact": {
          "type": "string",
          "description": "Phone number for the next of kin or alternative contact."
        },
        "gestationalAge": {
          "type": "number",
          "description": "Gestational age in weeks at the time of registration."
        },
        "firstAncDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date of the first ANC visit."
        },
        "registeredBy": {
          "type": "string",
          "description": "Name of the clinician or data clerk who performed the registration."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the record was created in the database."
        }
      },
      "required": [
        "participantId",
        "healthFacility",
        "name",
        "age",
        "maritalStatus",
        "phoneNumber",
        "gestationalAge",
        "firstAncDate"
      ]
    },
    "RecruitmentEntry": {
      "title": "Recruitment Entry",
      "description": "Daily recruitment tracking data logged by Research Assistants (RAs).",
      "type": "object",
      "properties": {
        "ra_name": { "type": "string" },
        "ra_uid": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "date_string": { "type": "string" },
        "facility": { "type": "string" },
        "providers": { "type": "number" },
        "total_anc": { "type": "number" },
        "eligible": { "type": "number" },
        "interviewed": { "type": "number" },
        "missed": { "type": "number" },
        "num_women": { "type": "number" },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "first_row_flag": { "type": "number", "nullable": true },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "IDIParticipant": {
      "title": "IDI Participant",
      "description": "A participant enrolled in the qualitative IDI sub-study.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "number" },
        "phone": { "type": "string" },
        "facility": { "type": "string" },
        "gestationalAge": { "type": "number" },
        "gravidity": { "type": "number" },
        "parity": { "type": "number" },
        "miscarriage": { "type": "number" },
        "educationLevel": { "type": "string" },
        "occupation": { "type": "string" },
        "residesInTemeke": { "type": "boolean" },
        "consentGiven": { "type": "boolean" },
        "notes": { "type": "string" },
        "nextOfKinName": { "type": "string" },
        "nextOfKinPhone": { "type": "string" },
        "nextOfKinRelation": { "type": "string" },
        "registered_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/anc_registrations/{registrationId}": {
      "schema": {
        "$ref": "#/entities/AncRegistration"
      },
      "description": "Stores all ANC participant registration records."
    },
    "/recruitment_entries/{entryId}": {
      "schema": {
        "$ref": "#/entities/RecruitmentEntry"
      },
      "description": "Stores daily recruitment tracking entries."
    },
    "/idi_participants/{participantId}": {
      "schema": {
        "$ref": "#/entities/IDIParticipant"
      },
      "description": "Stores all qualitative sub-study participant records."
    }
  }
}
