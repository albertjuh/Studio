
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // WARNING: These rules are insecure and are for prototyping only.
    // In a real app, you would have more granular rules based on user roles.

    // This allows unauthenticated access, which is necessary for the ANC
    // cohort app's offline sync feature to check for pending writes.
    // Forcing another update to ensure deployment.
    match /{path=**} {
      allow read, write: if true;
    }
  }
}
