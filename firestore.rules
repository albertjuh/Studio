
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // More specific match for ANC registrations
    match /anc_registrations/{registrationId} {
      // Allows any client to create a document.
      // This is necessary for the offline-first approach to work without Firebase Auth.
      // For production, you should secure this with Firebase App Check.
      allow create: if true;
      
      // Allow authenticated admins (from the main app) to read/update/delete.
      allow read, update, delete: if request.auth != null;
    }

    // Match all OTHER documents. This is intentionally broad for the prototype.
    match /{path=**} {
      // This rule will not be checked for /anc_registrations because the rule above is more specific.
      allow read, write: if request.auth != null && path[0] != 'anc_registrations';
    }
  }
}
