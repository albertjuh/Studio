
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ANC Cohort Study: Allow reads and writes if a user is authenticated (including anonymous).
    // This rule is critical for enabling offline-first functionality.
    match /anc_registrations/{registrationId} {
      allow read, write: if request.auth != null;
    }

    // WARNING: The rules below are insecure and for prototyping only.
    // In a real app, you would have more granular rules based on user roles.
    match /inventory/{doc=**} {
        allow read, write: if true;
    }
    match /inventory_logs/{doc=**} {
        allow read, write: if true;
    }
    match /production_logs/{doc=**} {
        allow read, write: if true;
    }
    match /nyanga_reports/{doc=**} {
        allow read, write: if true;
    }
    match /nyanga_workers/{doc=**} {
        allow read, write: if true;
    }
  }
}
