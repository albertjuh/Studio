{
  "hosting": {
    "site": "nutshell-insights",
    "rewrites": [
      {
        "source": "**",
        "apphosting": "nutshell-insights"
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}